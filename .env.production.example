# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy values into Render (backend) and Vercel (frontend) dashboards.
# =============================================================================

# --- Neon PostgreSQL (use in Render backend) ---
# Direct connection (migrations, seed):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
#
# Pooled connection (recommended for app runtime on Render):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL=

# --- Render Backend ---
NODE_ENV=production
PORT=10000
API_URL=https://crm-api.onrender.com
FRONTEND_URL=https://your-app.vercel.app

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Vercel Frontend ---
NEXT_PUBLIC_API_URL=https://crm-api.onrender.com/api
