{
  "name": "break-build-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise CRM Platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "node -e \"require('fs').copyFileSync('.env','backend/.env')\"",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "kill-ports": "lsof -ti :4000,:3000 | xargs kill -9 2>/dev/null || true",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm run start:prod",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:migrate:deploy": "cd backend && npm run db:migrate:deploy",
    "db:seed": "cd backend && npm run db:seed",
    "db:push": "cd backend && npm run db:push",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "verify:production": "bash scripts/verify-production-build.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
