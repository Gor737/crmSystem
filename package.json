{
  "name": "break-build-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise CRM Platform",
  "scripts": {
    "predev": "node -e \"require('fs').copyFileSync('.env','backend/.env')\"",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "kill-ports": "lsof -ti :4000,:3000 | xargs kill -9 2>/dev/null || true",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:seed": "cd backend && npm run db:seed",
    "db:push": "cd backend && npm run db:push",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3"
  }
}
